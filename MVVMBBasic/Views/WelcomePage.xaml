<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ViewModels"
             x:Class="Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30"
                         Spacing="25"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Welcome"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Choose a calculator"
               FontSize="18"
               HorizontalOptions="Center" />

        <Button Text="Age Calculator"
                Command="{Binding NavigateToAgeCalculatorCommand}"
                HeightRequest="55"
                WidthRequest="250" />

        <Button Text="Math Calculator"
                Command="{Binding NavigateToMathCalculatorCommand}"
                HeightRequest="55"
                WidthRequest="250" />

    </VerticalStackLayout>

</ContentPage>
